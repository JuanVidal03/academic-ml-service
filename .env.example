# ---------------------------------------------------------------------------
# All variables are optional; the service runs with the defaults shown here.
# Copy to .env and adjust.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Leave unset to run without a database: predictions
# still work, they are just not logged and GET /predictions returns 503.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dropout_db

# Browser origins allowed to call this API. Must list your real frontend
# origins in production. Never use "*": the API is called with credentials.
CORS_ORIGINS=["http://localhost:5173"]

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Training ---------------------------------------------------------------
# Fraction of the dataset held out for the final evaluation.
TEST_SIZE=0.2
# Cross-validation folds used for model comparison and tuning.
CV_FOLDS=5
# Seed for every split and estimator, so runs are reproducible.
RANDOM_STATE=42
# Minimum recall the decision threshold must reach. Higher catches more at-risk
# students at the cost of more false alarms.
TARGET_RECALL=0.80

# --- Risk banding (institutional policy, not a statistical result) ----------
# probability < medium -> "bajo"; medium..high -> "medio"; >= high -> "alto"
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60
