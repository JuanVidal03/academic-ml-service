# ---------------------------------------------------------------------------
# Copy to .env before running anything:   cp .env.example .env
#
# The values below are REQUIRED. They have no default in the code, so a missing
# one makes the service refuse to start with a ValidationError naming the field.
# That is deliberate: every one of them changes either who may call the API or
# which model gets trained, and silently substituting a value nobody chose is
# worse than failing loudly.
#
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# The service stores its model, training data and audit log here, so there is
# nothing to fall back to. A bare postgresql:// URL is rewritten to
# postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/dropout_db

# --- API (required) --------------------------------------------------------
# Browser origins allowed to call this API. Must list your real frontend
# origins. Never use "*": the API is called with credentials.
CORS_ORIGINS=["http://localhost:5173"]

# --- Training (required) ---------------------------------------------------
# Fraction of the dataset held out for the final evaluation.
TEST_SIZE=0.2
# Cross-validation folds used for model comparison and tuning.
CV_FOLDS=5
# Seed for every split and estimator, so runs are reproducible.
RANDOM_STATE=42
# Minimum recall the decision threshold must reach. Higher catches more at-risk
# students at the cost of more false alarms.
TARGET_RECALL=0.80

# --- Risk banding (required; institutional policy, not a statistical result) -
# probability < medium -> "bajo"; medium..high -> "medio"; >= high -> "alto"
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60

# --- Optional --------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
# LOG_LEVEL=INFO
