# Database connection (optional - service works without it using CSV fallback)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dropout_db

# CORS origins (comma-separated list for multiple origins)
# Add your NestJS backend and React frontend URLs
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Optional: Custom model path (defaults to models/model.joblib)
# MODEL_PATH=/path/to/custom/model.joblib
