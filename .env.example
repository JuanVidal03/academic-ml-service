# ---------------------------------------------------------------------------
# Copy to .env before running anything:   cp .env.example .env
#
# The values below are REQUIRED. They have no default in the code, so a missing
# one makes the service refuse to start with a ValidationError naming the field.
# That is deliberate: every one of them changes either who may call the API or
# which model gets trained, and silently substituting a value nobody chose is
# worse than failing loudly.
#
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# The service stores its model, training data and audit log here, so there is
# nothing to fall back to. A bare postgresql:// URL is rewritten to
# postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/dropout_db

# --- Authentication (required) ---------------------------------------------
# Signing key for access tokens. At least 32 characters, and NEVER a value that
# has been committed anywhere: whoever knows it can mint a valid token for any
# account. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret-at-least-32-characters-long
# Access-token lifetime. Short, because it cannot be revoked once issued.
ACCESS_TOKEN_MINUTES=15
# Refresh-token lifetime. Revocable, rotated on every use.
REFRESH_TOKEN_DAYS=7

# --- Cookies (optional, but read this one) ---------------------------------
# COOKIE_SECURE defaults to true, which is correct in production. A browser
# SILENTLY REFUSES a Secure cookie over plain http://localhost, so on a local
# http dev server login appears to succeed and every refresh then fails with
# "no hay sesión". Set it false for local development over http.
COOKIE_SECURE=false
# lax | strict | none. "none" requires COOKIE_SECURE=true and is only needed
# when the API and the frontend are on different registrable domains.
COOKIE_SAMESITE=lax

# --- API (required) --------------------------------------------------------
# Browser origins allowed to call this API. Must list your real frontend
# origins. Never use "*": the API is called with credentials.
CORS_ORIGINS=["http://localhost:5173"]

# --- Training (required) ---------------------------------------------------
# Fraction of the dataset held out for the final evaluation.
TEST_SIZE=0.2
# Cross-validation folds used for model comparison and tuning.
CV_FOLDS=5
# Seed for every split and estimator, so runs are reproducible.
RANDOM_STATE=42
# Minimum recall the decision threshold must reach. Higher catches more at-risk
# students at the cost of more false alarms; 0.85 flags ~65% of students to catch ~86%
# of real dropouts. Raising this is the only lever that moves the headline number --
# ROC-AUC (~0.77) is set by the features, not by this setting.
TARGET_RECALL=0.85

# --- Risk banding (required; institutional policy, not a statistical result) -
# probability < medium -> "bajo"; medium..high -> "medio"; >= high -> "alto"
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60

# --- Optional --------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Defaults to INFO.
# LOG_LEVEL=INFO
